<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Underscored test names, like the Macro Deck repository's own test projects. Inline expected
             arrays (CA1861) keep each assertion readable and only run once per test. -->
        <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- For ManualTimeProvider, so scheduling tests control time without sleeping. -->
        <PackageReference Include="MacroDeck.Plugin.Testing" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="NUnit" />
        <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
        <PackageReference Include="NUnit3TestAdapter" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\TodoList.Core\TodoList.Core.csproj" />
    </ItemGroup>

</Project>
